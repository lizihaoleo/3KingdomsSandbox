        "曹叡",
        "黄权",
        "黄月英",
        "刘禅"
      ],
      "since": 11,
      "last": 19,
      "major": true
    },
    {
      "id": 47,
      "title": "董允绢书",
      "detail": "瞻儿出宫由董允经办。他看见后主在宫门口站了很久，只说了一句「陛下保重」，别的仍旧什么也没问。",
      "actors": [
        "董允",
        "刘禅",
        "黄月英"
      ],
      "since": 15,
      "last": 19
    },
    {
      "id": 50,
      "title": "刺驾密令",
      "detail": "辛毗在太傅之议上当殿提起刺驾密令，还是没能拦住曹爽。后主下令不趁魏丧出兵，密令原件仍然留在成都。孙权写信催蜀国把它昭告天下。",
      "actors": [
        "曹叡",
        "曹爽",
        "司马懿",
        "刘禅"
      ],
      "since": 17,
      "last": 18
    },
    {
      "id": 51,
      "title": "舅氏家书",
      "detail": "皇后的家书和召郭淮问罪的诏书一起被射进天水城，促成了城破。夏侯霸留守长安，没有西援，怀里仍揣着那封信。",
      "actors": [
        "夏侯霸",
        "刘禅",
        "曹爽",
        "郭淮"
      ],
      "since": 18,
      "last": 19
    },
    {
      "id": 52,
      "title": "太傅之局",
      "detail": "夏侯玄战败，天水失守，朝野都说根子在召回郭淮的那道诏书。太傅仍旧称病，司马师暗中收拢死士，辛宪英写信劝他不要轻动。",
      "actors": [
        "曹爽",
        "司马懿",
        "司马师",
        "辛宪英"
      ],
      "since": 18,
      "last": 19
    },
    {
      "id": 53,
      "title": "上邽孤垒",
      "detail": "天水归汉后，郭淮抗诏突围，与邓艾同守上邽坞堡。曹爽视郭淮为抗命之臣，司马懿暗中护着他，姜维攻了三天没能攻下。",
      "actors": [
        "郭淮",
        "邓艾",
        "姜维",
        "曹爽"
      ],
      "since": 19,
      "last": 19
    },
    {
      "id": 54,
      "title": "定军山寻墓",
      "detail": "司马懿读了蜀主密信的抄本，疑心孔明诈死，派心腹西行寻找定军山上的丞相墓，打算开棺验看。马岱奉命在那里密守。",
      "actors": [
        "司马懿",
        "马岱",
