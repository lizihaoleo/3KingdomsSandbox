    "关银屏": "手握吴船伏兵的证据，决定怎么用",
    "司马懿": "关中稳住了，却被指拿寿春换粮",
    "辛宪英": "要决定是否再去成都",
    "诸葛亮": "仓廪见底，流民又不断涌来",
    "张飞": "江陵兵已收拢，要处置吴船案",
    "姜维": "押送细作，陇西又有机会"
  },
