    "陆逊": "汉水尽归汉家，公安如何应对",
    "孙权": "病愈后要重新估量吴汉盟约",
    "诸葛亮": "陇右已稳，下一步怎么走",
    "姜维": "追问天子为何能先知",
    "关银屏": "江陵防疫，伯父伤重",
    "董允": "成都谶语暗中流传"
  },
  "threads": [
    {
      "id": 2,
      "title": "世子来历之谜",
      "detail": "张郃上奏说蜀营好像预先知道他的打算，司马懿把奏章放进那只匣子。姜维也读到了天子手书里那句话。",
      "actors": [
        "刘禅",
        "诸葛亮",
        "黄月英",
        "刘备"
      ],
      "since": 2,
      "last": 21,
      "major": true
    },
    {
      "id": 24,
      "title": "顾命相疑",
      "detail": "曹真当众指斥司马懿献匣邀功。司马懿呈上姜维的旧信，夏侯楙被召回。两路败报送到后，少帝命司马懿都督荆豫，出镇宛城。",
      "actors": [
        "司马懿",
        "辛宪英",
        "蒋济"
      ],
      "since": 19,
      "last": 21
    },
    {
      "id": 25,
      "title": "汉水之忌",
      "detail": "樊城陷落，汉水两岸都归了关羽。孙权病愈后对诸葛瑾说出忌惮的话，陆逊在公安按兵观望，吴汉盟约开始出现裂痕。",
      "actors": [
        "孙权",
        "陆逊",
        "关羽",
        "费祎"
      ],
      "since": 21,
      "last": 21
    },
    {
      "id": 26,
      "title": "申仪诈质",
      "detail": "申仪答应献出宛西的城门，送来的“子弟”却是家奴。廖化没有出兵，申仪背后是否有司马懿在设局，还没有查清。",
      "actors": [
        "廖化",
        "司马懿",
        "刘封"
      ],
      "since": 21,
      "last": 21
    },
    {
      "id": 27,
      "title": "禅授之谶",
      "detail": "成都的酒户和豪族不满禁酒，有方士私下传话：“先主名备，备就是具；今上名禅，禅就是授。”又拿天子防疫的话说得太准做文章，说他是“受人授意”。",
      "actors": [
        "刘禅",
        "董允",
        "吴夫人"
      ],
      "since": 21,
      "last": 21
    }
