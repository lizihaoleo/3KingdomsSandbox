  "threads": [
    {
      "id": 2,
      "title": "世子来历之谜",
      "detail": "吴使书佐当殿拿出偷抄的预言纸页，告天子行巫蛊。天子用宫中没有亲笔、金账上有买字记录两件事化解，诸葛瑾却记下了纸页的日期。黄月英已点清知情人名单。",
      "actors": [
        "刘禅",
        "诸葛亮",
        "黄月英",
        "刘备"
      ],
      "since": 2,
      "last": 38,
      "major": true
    },
    {
      "id": 38,
      "title": "幼主与陆逊",
      "detail": "天子当殿开出称藩条件，写成诏书由诸葛瑾带回。孙霸旧党在成都告巫蛊、在淮上越界，都没有得逞，合肥反而丢了，陆逊在会稽平定了山越。",
      "actors": [
        "陆逊",
        "诸葛瑾",
        "朱然",
        "刘禅"
      ],
      "since": 37,
      "last": 38
    },
    {
      "id": 39,
      "title": "交州孙霸",
      "detail": "孙霸流放交州，与士氏割据交趾的势力合流，又通过校事旧线和合肥的全寄联手，想搅黄称藩，拥立自己。陆逊只守住番禺，交州的乱子还没有平定。",
      "actors": [
        "陆逊",
        "刘禅",
        "诸葛瑾"
      ],
      "since": 38,
      "last": 38
    },
    {
      "id": 40,
      "title": "合肥去留",
      "detail": "合肥守军断粮后开城迎汉，关平入城暂守。寿春与建业的联系被拦腰切断，这座城是归汉，还是在称藩时还给吴国，成了议约中的新筹码。",
      "actors": [
        "关平",
        "朱然",
        "陆逊",
        "刘禅"
      ],
      "since": 38,
      "last": 38
    }
