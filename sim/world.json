    "关羽": "与吴军隔颍水对峙",
    "诸葛亮": "拿着蒲坂之粮，如何回应称藩",
    "司马懿": "大胜之后，要不要南下",
    "蒋济": "重新掌权，如何处置曹爽",
    "辛宪英": "得知蒲坂交粮，重新谋划",
    "关银屏": "吴米断了，江口如何防备"
  },
