  "threads": [
    {
      "id": 2,
      "title": "世子来历之谜",
      "detail": "魏少帝夜读辛宪英取来的证词，起了疑心；姜维归汉，必定要问“蜀中怎么知道祁山有我”。",
      "actors": [
        "刘禅",
        "诸葛亮",
        "黄月英",
        "刘备"
      ],
      "since": 2,
      "last": 20,
      "major": true
    },
    {
      "id": 23,
      "title": "吴失合肥",
      "detail": "吴军长围合肥，施水上烧了寿春的援船，但大疫使吴营病倒近三成；徐晃的二万援军正在东来，满宠城中粮尽在即，下季见分晓。",
      "actors": [
        "孙权",
        "陆逊",
        "朱然",
        "刘禅"
      ],
      "since": 16,
      "last": 20
    },
    {
      "id": 24,
      "title": "顾命相疑",
      "detail": "司马懿轻车入朝，献匣表明无私，与蒋济联名救合肥获准，曹真的异议被少帝驳回。两人从暗斗转入朝堂上的明争。",
      "actors": [
        "司马懿",
        "辛宪英",
        "蒋济"
      ],
      "since": 19,
      "last": 20
    },
    {
      "id": 25,
      "title": "陇右反扑",
      "detail": "马遵逃往上邽，夏侯楙和曹真不能坐视天水失守，必定从长安、陇西调兵夺回。姜维新近归汉，魏延心里不服，汉中的粮又只够到秋收。",
      "actors": [
        "姜维",
        "魏延",
        "诸葛亮"
      ],
      "since": 20,
      "last": 20
    },
    {
      "id": 26,
      "title": "宛城空虚",
      "detail": "徐晃分兵二万东援合肥，宛城只剩四万人，还有曹真派来的监军掣肘。关羽守丧期快满，北岸露出了空子，可天子有“不许上岸”的诏令。",
      "actors": [
        "关羽",
        "徐晃",
