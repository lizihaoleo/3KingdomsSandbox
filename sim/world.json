      "last": 19,
      "major": true
    },
    {
      "id": 23,
      "title": "吴失合肥",
      "detail": "孙权亲出濡须，朱然、陆逊夺下巢湖口，焚毁施水粮船，合围合肥。满宠死守内城，许昌的援兵被曹真压住不发。",
      "actors": [
        "孙权",
        "陆逊",
        "朱然",
        "刘禅"
      ],
      "since": 16,
      "last": 19
    },
    {
      "id": 24,
      "title": "顾命相疑",
      "detail": "曹真秘不发丧，司马懿抢先在宛城发丧，又不肯入朝。曹真压下他还兵武都的奏表，还派了监军；武都失守后，曹真脸上无光，与司马懿的嫌隙更深。",
      "actors": [
        "司马懿",
        "辛宪英",
        "蒋济"
      ],
      "since": 19,
      "last": 19
    },
    {
      "id": 25,
      "title": "天水姜维",
      "detail": "姜维在祁山大破汉军前锋，可夏侯楙怯懦，不肯重用他。天子听到这个名字后神色异样，丞相也开始留意这员魏将。",
      "actors": [
