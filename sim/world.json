      ],
      "since": 2,
      "last": 34,
      "major": true
    },
    {
      "id": 34,
      "title": "子元去就",
      "detail": "司马师奉遗命打着汉旗攻下下邳，派司马昭回邺城治丧，自己仍握着兵权不交，营中竖的是司马家的大纛。",
      "actors": [
        "诸葛亮",
        "赵云",
        "孙权"
      ],
      "since": 33,
      "last": 34
    },
    {
      "id": 35,
      "title": "仲达遗言",
      "detail": "天子事先写信点明要留心有旧怨的将吏，张飞果然死在这样的人手里。丞相读完军报，又想起了仲达的遗言。",
      "actors": [
        "诸葛亮",
        "刘禅"
      ],
      "since": 33,
      "last": 34
    },
    {
      "id": 36,
      "title": "翼德之仇",
      "detail": "张飞被吴人收买的帐下将刺杀。孙权当众否认下过命令，关羽誓要报仇，天子却有诏在先，不许追过沙羡。刺客张达、范强关在江陵狱中，供词还没有审出来。",
      "actors": [
