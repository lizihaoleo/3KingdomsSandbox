  "threads": [
    {
      "id": 5,
      "title": "西陵增兵",
      "detail": "孙权密令陆逊整顿舟师，开春去探襄阳的虚实。永安方向的兵备照旧不撤，步骘在西陵增筑了烽堠，表面上仍和蜀人亲睦。",
      "actors": [
        "孙权",
        "陆逊"
      ],
      "since": 1,
      "last": 6
    },
    {
      "id": 7,
      "title": "孔明遗孀识魂",
      "detail": "黄月英把丞相的遗稿编成《丞相遗策》进呈，秋战之谋从此有了出处。她与皇后约定，御笔当夜焚毁，誊本由二人共管。",
      "actors": [
        "黄月英",
        "刘禅"
      ],
      "since": 2,
      "last": 6
    },
    {
      "id": 9,
      "title": "杨仪徙汉嘉",
      "detail": "杨仪托费祎代呈表章，请以白衣赴汉中督运。消息传开后，魏延旧部哗变，姜维上表说杨仪不可再到汉中。表章年底才到成都，后主还没有批答。",
      "actors": [
        "杨仪",
        "费祎"
      ],
      "since": 2,
      "last": 6
    },
    {
      "id": 10,
      "title": "关中屯田",
      "detail": "魏主命邓艾典关中屯田，冬天在上邽补种冬麦、修筑城垒，郭淮也把余粮分囤进祁山各堡。",
      "actors": [
        "邓艾",
        "司马懿",
        "曹爽"
      ],
      "since": 2,
      "last": 6
    },
    {
      "id": 11,
      "title": "诸葛瑾之疑",
      "detail": "孙权密令诸葛瑾借吊唁魏延之机，探问蜀人明春出兵与否、粮草多少。瑾听说了《遗策》的事，在奏报里写“蜀主依亮遗策用兵”，自己却并不全信。",
      "actors": [
        "诸葛瑾",
        "刘禅",
        "黄月英",
        "孙权"
      ],
      "since": 3,
      "last": 6
    },
    {
      "id": 14,
      "title": "黄皓守陵",
      "detail": "董允依皇后所托，在惠陵加派了看守。有个蜀锦商人借谒陵之机，向黄皓打听陛下幼时的旧事，黄皓反手把这件事报给了看守，似乎想借此立功复起。",
      "actors": [
        "黄皓",
        "张皇后"
      ],
      "since": 3,
      "last": 6
    },
    {
      "id": 18,
      "title": "鬼附之谣",
      "detail": "《丞相遗策》的说法传到洛阳，魏主认定是孔明的遗谋，鬼附之谣在朝堂上压了下去，只有司马懿不信。",
