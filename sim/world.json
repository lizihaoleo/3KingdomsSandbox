      ],
      "since": 24,
      "last": 29
    },
    {
      "id": 32,
      "title": "邺许分裂",
      "detail": "司马懿被劫出狱后占据邺城，斩了吴使，上表要清君侧。曹爽诏他为逆臣，魏国分成许昌和邺城两半，河北诸郡只听邺城的。",
      "actors": [
        "司马懿",
        "蒋济",
