    },
    {
      "id": 69,
      "title": "鲁王怨望",
      "detail": "玉玺归汉以后，鲁王党在朝中散布汉家迟早要吞并吴国的说法，孙权拿出寿春捷报压了下去，但「盟书还在」这句话是写给汉家看的。",
      "actors": [
        "孙权",
        "孙和",
        "全琮",
        "诸葛恪"
      ],
      "since": 29,
      "last": 31
    },
    {
      "id": 70,
      "title": "沔阳删句",
      "detail": "告祭文中有一句「神器有归，非力所争」，是孔明在沔阳起草汉中王表时亲手删掉的，当时只有先主、法正、黄权在场。天子亲笔写出了这句话，黄权私下追问蒋琬，蒋琬也暗生疑心。",
      "actors": [
        "黄权",
        "蒋琬",
        "刘禅",
        "黄月英"
      ],
      "since": 31,
      "last": 31
    },
    {
      "id": 71,
      "title": "王凌入洛",
      "detail": "王凌把寿春交给吴国，带五千旧部西赴洛阳侍奉旧主，到了才知道玉玺已经归汉、少帝受封为崇德公。这个曹氏老将去留未定，心中有怨。",
      "actors": [
        "曹芳",
        "姜维",
        "蒋琬"
      ],
      "since": 31,
      "last": 31
    }
