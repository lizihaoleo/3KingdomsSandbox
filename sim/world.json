    "辛宪英": "已知贾充所为，须决定是否进言",
    "孙权": "取得淮南，又见汉得玉玺",
    "姜维": "王凌带旧部入洛，北伐之请待批",
    "黄月英": "须设法替告祭文那一句补出来历",
    "邓艾": "刚归汉督率屯田"
  },
