    "陆逊": "白衣之策被点破，惊疑汉帝",
    "诸葛瑾": "持吴王索荆南之信待拆",
    "黄月英": "吴公主打听木牛坊册子",
    "关羽": "还镇江陵，郾城失守之责",
    "诸葛亮": "受玺后安置许昌与对邺",
    "辛宪英": "归汉后随侍陈留王的抉择"
  },
