  "threads": [
    {
      "id": 2,
      "title": "世子来历之谜",
      "detail": "魏廷张榜称汉帝能知魏主寿数，是妖异附体。黄月英在木牛坊用沙盘破了这个说法，诸葛瑾转而以为汉帝的智谋出自丞相夫妇。",
      "actors": [
        "刘禅",
        "诸葛亮",
        "黄月英",
        "刘备"
      ],
      "since": 2,
      "last": 28,
      "major": true
    },
    {
      "id": 31,
      "title": "宪英之察",
      "detail": "司马公下狱后，宪英对郭淮说：“汉帝料的是人心，连仲达交兵东去也算在里面。”她留在长安稳住各营，却眼看着武威归了汉家。",
      "actors": [
        "辛宪英",
        "司马懿",
        "刘禅",
        "黄月英"
      ],
      "since": 24,
      "last": 28
    },
    {
      "id": 33,
      "title": "汝南之围",
      "detail": "朱然在颍口烧沉了河东运来的粮船，关羽屯兵郾城，陆路也断了。满宠斩了劝降的军候，城中只剩一万饥兵。",
      "actors": [
        "孙权",
        "满宠",
        "朱然",
        "刘禅",
        "关羽"
      ],
      "since": 27,
      "last": 28
    },
    {
      "id": 34,
      "title": "仲达狱中",
      "detail": "司马懿因求辅政的信被下了廷尉狱，曹爽想杀他，蒋济力保。长安诸将各自观望，郭淮暂代都督。他在狱门前那句话，也让魏廷把汉帝说成了妖异。",
      "actors": [
        "司马懿",
        "蒋济",
        "辛宪英",
        "刘禅"
      ],
      "since": 28,
      "last": 28
    },
    {
      "id": 35,
      "title": "吴使北联邺",
      "detail": "孙权趁魏丧派使者北上邺城，联络河北诸郡，想拉拢许昌以北的人。邺城守将的态度至今不明。",
      "actors": [
        "孙权",
        "蒋济"
      ],
