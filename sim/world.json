  "threads": [
    {
      "id": 33,
      "title": "棺中八尺之尸",
      "detail": "曹爽一党根据收购来的手迹编出借尸檄文，太常代读祝文、后主当众以休兵诏令驳斥，谣言被化解；张嶷却听出了丞相的旧令。",
      "actors": [
        "曹叡",
        "黄权",
        "黄月英",
        "刘禅"
      ],
      "since": 11,
      "last": 17,
      "major": true
    },
    {
      "id": 42,
      "title": "吕壹遗言",
      "detail": "诸葛瑾写信告诉太子，吕壹摹写的手书已经流到了许昌。孙登翻检旧匣，烧掉了几十件可疑的书札，又去问顾雍那句话，顾雍这回只说：「等至尊还朝，殿下亲自去问。」",
      "actors": [
        "孙登",
        "费祎",
        "孙权"
      ],
      "since": 13,
      "last": 18
    },
    {
      "id": 47,
      "title": "董允绢书",
      "detail": "黄夫人托董允把遗稿交给张嶷，董允照办了。他由此知道黄夫人一直在替天子补漏，心里的猜测更深了，嘴上依旧什么也不说。",
      "actors": [
        "董允",
        "刘禅",
        "黄月英"
      ],
      "since": 15,
      "last": 18
    },
    {
      "id": 48,
      "title": "襄阳长围",
      "detail": "陆逊攻心，一个冬天招降了一万多名缒城出降的守卒。满宠被淮南的袭扰拖住，没能西援。襄阳城里人心浮动，守城副将斩了吴使才勉强压住。",
      "actors": [
        "陆逊",
        "满宠",
        "朱然"
      ],
      "since": 16,
      "last": 18
    },
    {
      "id": 50,
      "title": "刺驾密令",
      "detail": "辛毗在太傅之议上当殿提起刺驾密令，还是没能拦住曹爽。后主下令不趁魏丧出兵，密令原件仍然留在成都。孙权写信催蜀国把它昭告天下。",
      "actors": [
        "曹叡",
        "曹爽",
        "司马懿",
        "刘禅"
      ],
      "since": 17,
      "last": 18
    },
    {
      "id": 51,
      "title": "舅氏家书",
      "detail": "张皇后给夏侯霸的家书里写了一段只有夏侯家人才知道的旧事。夏侯霸被郭淮断粮逼退到长安，没有烧掉这封信。曹爽、郭淮两边都在疑他。",
      "actors": [
        "夏侯霸",
        "刘禅",
        "曹爽",
        "郭淮"
      ],
      "since": 18,
      "last": 18
    },
    {
      "id": 52,
      "title": "太傅之局",
      "detail": "曹爽以天子名义尊司马懿为太傅，夺了他录尚书事的职权，违背了先帝两人同署的遗诏。司马懿交出印信，手里却多了郭淮封送来的曹爽私信，刘放、孙资也从此冷眼旁观。",
      "actors": [
        "曹爽",
        "司马懿",
        "司马师",
        "辛宪英"
      ],
      "since": 18,
      "last": 18
    },
    {
      "id": 53,
      "title": "夏侯擅退",
      "detail": "夏侯霸没有奉诏就从天水以东退回长安，营中士卒逃散了将近一半。按军法当问罪，曹爽要保他，太傅那边握着他的把柄，关中谁来统辖还没有定。",
      "actors": [
        "夏侯霸",
        "曹爽",
        "郭淮",
        "夏侯玄"
      ],
      "since": 18,
      "last": 18
    }
